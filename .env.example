# Nephtys - variables d'environnement (frontend Vite)
# Copier vers `.env` et renseigner.

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CAPTCHA anti-robot (gratuit). Activer côté edge function avec les secrets
# CAPTCHA_ENABLED / CAPTCHA_SECRET_KEY (voir docs/CAPTCHA.md).
VITE_CAPTCHA_ENABLED=false
VITE_CAPTCHA_PROVIDER=turnstile
VITE_CAPTCHA_SITE_KEY=
